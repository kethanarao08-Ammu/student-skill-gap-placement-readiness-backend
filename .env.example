# Local MySQL configuration
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/student_readiness_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT secret: supply a randomly generated Base64 key with at least 256 bits
JWT_SECRET=replace_with_a_random_base64_secret
JWT_EXPIRATION_MS=86400000

# Server and CORS configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
